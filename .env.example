# === Mode ===
DEMO_MODE=true

# === Exchange ===
API_KEY=your_binance_api_key
API_SECRET=your_binance_api_secret

# === Grid ===
SYMBOL=BTCUSDT
LEVERAGE=2
GRID_COUNT=15
CAPITAL_PER_GRID_PCT=0.05

# === Auto Range (ATR-based) ===
RANGE_LOOKBACK_DAYS=14
RANGE_ATR_MULTIPLIER=1.5
RANGE_MIN_SPACING_PCT=0.005

# === Risk ===
STOP_LOSS_PCT=0.03
DAILY_LOSS_LIMIT_PCT=0.05
MAX_DRAWDOWN_PCT=0.10
COOLDOWN_SECONDS=3600

# === Trend Filter ===
EMA_FAST=20
EMA_SLOW=50
ADX_PERIOD=14
ADX_TREND_THRESHOLD=25
ADX_RANGE_THRESHOLD=20
TREND_CHECK_INTERVAL=300

# === Telegram ===
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Polling ===
POLL_INTERVAL=30
FORCE_TRADE_NOW=false
