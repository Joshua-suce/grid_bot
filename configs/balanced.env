# Profile: balanced
#
# This mirrors the parameters the bot has actually been running with in
# logs/trades.csv (2026-07-28 -> 2026-08-10): 1,361 fills / 882 completed
# cycles over ~13.6 days, 84.7% win rate, net PnL ~$332 (~$24/day),
# fees ~10.7% of gross profit. Kept here as the reference baseline so you
# can always switch back and compare other profiles against it.
#
# To use: set GRID_BOT_ENV_FILE=configs/balanced.env (your .env still
# supplies API_KEY/API_SECRET/TELEGRAM_* -- this file only overlays the
# tuning parameters below).

# --- Grid ---
GRID_COUNT=20
CAPITAL_PER_GRID_PCT=0.018
CAPITAL_PER_GRID_USDT=5
REPLACEMENT_COOLDOWN=20

# --- Auto Range (ATR-based) ---
RANGE_LOOKBACK_DAYS=2
RANGE_ATR_MULTIPLIER=2.5
RANGE_MIN_SPACING_PCT=0.001

# --- Grid Recentering ---
RECENTER_ENABLED=true
RECENTER_MARGIN_PCT=0.02
RECENTER_COOLDOWN=180

# --- Fees ---
MAKER_FEE_PCT=0.02
TAKER_FEE_PCT=0.04

# --- Risk ---
LEVERAGE=5
STOP_LOSS_PCT=0.03
TRAILING_SL_TRIGGER_PCT=0.05
DAILY_LOSS_LIMIT_PCT=0.03
MAX_DRAWDOWN_PCT=0.10
MAX_EXPOSURE_PCT=0.50
MAX_POSITION_PCT=0.12
SL_SCALE_OUT_PCT=0.5
COOLDOWN_SECONDS=3600
MAX_RECOVERY_COUNT=5
MAX_CONSECUTIVE_LOSSES=10

# --- Trend Filter ---
EMA_FAST=20
EMA_SLOW=50
ADX_PERIOD=14
ADX_TREND_THRESHOLD=30
ADX_RANGE_THRESHOLD=15
TREND_TIMEFRAME_FAST=30m
TREND_TIMEFRAME=1h
TREND_CHECK_INTERVAL=300
TREND_CONFIRMATION_SECONDS=300

# --- Polling ---
POLL_INTERVAL=10
