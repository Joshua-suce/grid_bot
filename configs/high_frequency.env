# Profile: high_frequency
#
# Same risk envelope as configs/balanced.env, tuned for more completed
# cycles per day and less fee/loss drag. Every change below is tied to a
# specific finding from tools/analyze_performance.py run against the bot's
# own trade history (logs/trades.csv, 07-28 -> 08-10):
#
#   1) Regime breakdown showed "downtrend"-tagged fills are the only net
#      LOSER: 73 trades, net -$9.51 (vs +$122 for "ranging", +$216 for
#      "uncertain"). The two single worst losses in the whole 13-day window
#      (-$13.43, -$8.90) both happened while the trend filter was still
#      catching up to a regime that had already turned. TREND_CHECK_INTERVAL
#      and TREND_CONFIRMATION_SECONDS were both 300s, i.e. up to ~10 minutes
#      of lag between a real trend forming and the grid pausing. Halving
#      both cuts that lag to ~4 minutes without making the filter twitchy
#      (still requires 2 minutes of a new regime holding before acting).
#
#   2) REPLACEMENT_COOLDOWN was engine-global (fixed alongside this profile,
#      see grid.py _is_on_cooldown/_mark_cooldown): a fill on ANY level used
#      to reset one shared timer that blocked replacement of orphaned/
#      cancelled orders on every OTHER level for up to 20s. That's now
#      per-level, so lowering the cooldown itself is safe -- it only ever
#      throttles a level that was juuust replaced, not the whole grid.
#
#   3) RANGE_ATR_MULTIPLIER trimmed 2.5 -> 2.1 for a moderately tighter grid
#      (more price crossings = more fills). Spacing is still kept above
#      RANGE_MIN_SPACING_PCT (0.001 = 0.1%), which itself sits ~2.6x above
#      the fee breakeven point (2 x MAKER_FEE_PCT = 0.04%), so this doesn't
#      push spacing anywhere near unprofitable.
#
# Everything else (risk limits, leverage, exposure caps) is unchanged from
# balanced.env on purpose -- this profile is about frequency and avoiding
# the trend-lag losses, not about taking more risk.
#
# Re-run tools/analyze_performance.py after a week or two on this profile
# and compare against the balanced.env baseline numbers above.

# --- Grid ---
GRID_COUNT=20
CAPITAL_PER_GRID_PCT=0.018
CAPITAL_PER_GRID_USDT=5
REPLACEMENT_COOLDOWN=8

# --- Auto Range (ATR-based) ---
RANGE_LOOKBACK_DAYS=2
RANGE_ATR_MULTIPLIER=2.1
RANGE_MIN_SPACING_PCT=0.001

# --- Grid Recentering ---
RECENTER_ENABLED=true
RECENTER_MARGIN_PCT=0.02
RECENTER_COOLDOWN=180

# --- Fees ---
MAKER_FEE_PCT=0.02
TAKER_FEE_PCT=0.04

# --- Risk (unchanged from balanced.env) ---
LEVERAGE=5
STOP_LOSS_PCT=0.03
TRAILING_SL_TRIGGER_PCT=0.05
DAILY_LOSS_LIMIT_PCT=0.03
MAX_DRAWDOWN_PCT=0.10
MAX_EXPOSURE_PCT=0.50
MAX_POSITION_PCT=0.12
SL_SCALE_OUT_PCT=0.5
COOLDOWN_SECONDS=3600
MAX_RECOVERY_COUNT=5
MAX_CONSECUTIVE_LOSSES=10

# --- Trend Filter (faster reaction, see note #1 above) ---
EMA_FAST=20
EMA_SLOW=50
ADX_PERIOD=14
ADX_TREND_THRESHOLD=30
ADX_RANGE_THRESHOLD=15
TREND_TIMEFRAME_FAST=30m
TREND_TIMEFRAME=1h
TREND_CHECK_INTERVAL=120
TREND_CONFIRMATION_SECONDS=120

# --- Polling ---
POLL_INTERVAL=10
