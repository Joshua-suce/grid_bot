# Profile: defensive
#
# For when you want to prioritize capital preservation over trade frequency
# (e.g. before switching this bot from demo to live funds). Uses the same
# faster trend reaction as high_frequency.env (that's a pure risk reduction,
# not a frequency trade-off -- see high_frequency.env note #1) but dials
# back size, leverage, and exposure instead of tightening the grid.

# --- Grid ---
GRID_COUNT=20
CAPITAL_PER_GRID_PCT=0.010
CAPITAL_PER_GRID_USDT=0
REPLACEMENT_COOLDOWN=20

# --- Auto Range (ATR-based) ---
RANGE_LOOKBACK_DAYS=2
RANGE_ATR_MULTIPLIER=2.5
RANGE_MIN_SPACING_PCT=0.0015

# --- Grid Recentering ---
RECENTER_ENABLED=true
RECENTER_MARGIN_PCT=0.02
RECENTER_COOLDOWN=180

# --- Fees ---
MAKER_FEE_PCT=0.02
TAKER_FEE_PCT=0.04

# --- Risk (tightened) ---
LEVERAGE=3
STOP_LOSS_PCT=0.03
TRAILING_SL_TRIGGER_PCT=0.04
DAILY_LOSS_LIMIT_PCT=0.02
MAX_DRAWDOWN_PCT=0.07
MAX_EXPOSURE_PCT=0.35
MAX_POSITION_PCT=0.08
SL_SCALE_OUT_PCT=0.5
COOLDOWN_SECONDS=3600
MAX_RECOVERY_COUNT=3
MAX_CONSECUTIVE_LOSSES=6

# --- Trend Filter (fast reaction = less time exposed to a turning market) ---
EMA_FAST=20
EMA_SLOW=50
ADX_PERIOD=14
ADX_TREND_THRESHOLD=28
ADX_RANGE_THRESHOLD=15
TREND_TIMEFRAME_FAST=30m
TREND_TIMEFRAME=1h
TREND_CHECK_INTERVAL=120
TREND_CONFIRMATION_SECONDS=120

# --- Polling ---
POLL_INTERVAL=10
